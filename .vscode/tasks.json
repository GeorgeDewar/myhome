{
    "tasks": [
        {
            "label": "CMake: configure Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-debug",
                "-G",
                "Visual Studio 17 2022",
                "-A",
                "x64",
                "-DCMAKE_TOOLCHAIN_FILE=C:/Users/George/Apps/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "-DVCPKG_INSTALLED_DIR=${workspaceFolder}/vcpkg_installed"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-debug",
                "--config",
                "Debug"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build"
        },
        {
            "label": "CMake: configure Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-release",
                "-G",
                "Visual Studio 17 2022",
                "-A",
                "x64",
                "-DCMAKE_TOOLCHAIN_FILE=C:/Users/George/Apps/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "-DVCPKG_INSTALLED_DIR=${workspaceFolder}/vcpkg_installed"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: build Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-release",
                "--config",
                "Release"
            ],
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}